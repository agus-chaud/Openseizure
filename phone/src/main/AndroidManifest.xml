<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        Companion bridge (watch-osd-message-delivery / Option F): talks to OSD's HTTP ingress on
        127.0.0.1:8080. Loopback only — see design "Threat Matrix" (bind target strictly
        127.0.0.1, never 0.0.0.0/LAN).
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
        Batch 5a: permissions required by OsdBridgeService (design Architecture Decision #8).
        FOREGROUND_SERVICE + FOREGROUND_SERVICE_CONNECTED_DEVICE are mandatory at targetSdk 34
        for a connectedDevice foreground service (startForeground throws SecurityException without).
        BLUETOOTH_CONNECT is the runtime prerequisite for the connectedDevice type on API 34
        (granted by SetupActivity in Batch 6; the service faults loudly if it is denied).
        RECEIVE_BOOT_COMPLETED / REQUEST_IGNORE_BATTERY_OPTIMIZATIONS arrive in Batch 6 (T6.1).
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".PhoneApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.SeizureGuardPhone">

        <!-- Not exported: started only by this app (SetupActivity / BootReceiver in Batch 6). -->
        <service
            android:name=".bridge.OsdBridgeService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

    </application>

</manifest>
