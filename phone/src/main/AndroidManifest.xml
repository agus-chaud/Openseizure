<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        Companion bridge (watch-osd-message-delivery / Option F): talks to OSD's HTTP ingress on
        127.0.0.1:8080. Loopback only — see design "Threat Matrix" (bind target strictly
        127.0.0.1, never 0.0.0.0/LAN).
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
        Batch 5a: permissions required by OsdBridgeService (design Architecture Decision #8).
        FOREGROUND_SERVICE + FOREGROUND_SERVICE_CONNECTED_DEVICE are mandatory at targetSdk 34
        for a connectedDevice foreground service (startForeground throws SecurityException without).
        BLUETOOTH_CONNECT is the runtime prerequisite for the connectedDevice type on API 34
        (granted by SetupActivity in Batch 6; the service faults loudly if it is denied).
        Batch 6: RECEIVE_BOOT_COMPLETED (resume after reboot) and REQUEST_IGNORE_BATTERY_OPTIMIZATIONS
        (one-shot exemption prompt from SetupActivity).
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:name=".PhoneApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.SeizureGuardPhone">

        <activity
            android:name=".setup.SetupActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Exported so BOOT_COMPLETED is always delivered; onReceive ignores any other action. -->
        <receiver
            android:name=".boot.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Daily silent summary, fired by an inexact AlarmManager alarm set by this app only. -->
        <receiver
            android:name=".summary.MorningSummaryReceiver"
            android:exported="false" />

        <!-- Not exported: started only by this app (SetupActivity / BootReceiver). -->
        <service
            android:name=".bridge.OsdBridgeService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

    </application>

</manifest>
