<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Marca esta app como una Wear OS app — OBLIGATORIO -->
    <uses-feature android:name="android.hardware.type.watch" />

    <!-- Sensores: necesario para acelerómetro -->
    <uses-permission android:name="android.permission.BODY_SENSORS" />

    <!-- Para Wear OS 4+: acceso a sensores en background -->
    <uses-permission android:name="android.permission.BODY_SENSORS_BACKGROUND" />

    <!-- Foreground Service: mantiene el monitoreo activo de noche -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_HEALTH" />
    <!--
        Android 14 (API 34): un foreground service de tipo "health" exige, ADEMÁS de
        FOREGROUND_SERVICE_HEALTH, AL MENOS UNO de un grupo de permisos de sensores.
        HIGH_SAMPLING_RATE_SENSORS es de tipo "normal" (se otorga al instalar, sin diálogo)
        y satisface ese requisito. Sin esto, startForeground() lanza SecurityException y la app
        crashea al iniciar el monitoreo (validado en hardware, Watch 8 / Wear OS).
    -->
    <uses-permission android:name="android.permission.HIGH_SAMPLING_RATE_SENSORS" />

    <!-- WakeLock: evita que el CPU duerma durante el monitoreo -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Vibración para las alarmas -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!--
        Android 13+ (API 33): mostrar notificaciones requiere este permiso, que el usuario
        debe conceder en runtime. Sin él, el foreground service corre igual pero su
        notificación persistente NO se ve. Lo ideal es que MainActivity lo pida en runtime
        (pendiente); para probar ya, se puede otorgar por adb (ver HARDWARE_RUNBOOK).
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
        Reanudar el monitoreo tras un reinicio del reloj o una actualización de la app.
        Origen: corte de campo 2026-10-08 (el reloj se reinició por batería y el monitoreo
        quedó apagado ~3,5 días porque nada lo reiniciaba). Ver DEC-069.
    -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!--
        DEC-072: alarmas exactas diarias (inicio 22:00, parada 10:00). USE_EXACT_ALARM (API 33+) se otorga
        automáticamente y el usuario no puede revocarla; esta app es de uso personal (sideload), no se publica en
        Play, donde la política restringe ese permiso a apps de alarma/calendario. SCHEDULE_EXACT_ALARM cubre
        API 31-32 (el Galaxy Watch 8 es API 34; minSdk 30 no necesita ninguno). Si faltara, el horario se degrada a
        alarmas inexactas con un aviso silencioso (MonitoringScheduler).
    -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" android:maxSdkVersion="32" />

    <!-- Necesario para comunicación con la Companion App -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault">

        <uses-library
            android:name="com.google.android.wearable"
            android:required="true" />

        <!-- Necesario para Wear OS standalone app -->
        <meta-data
            android:name="com.google.android.wearable.standalone"
            android:value="true" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.DeviceDefault">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            SeizureMonitorService — Fase 1.1
            foregroundServiceType="health" es obligatorio en API 30+ para que el
            OS permita startForeground() desde un Service de monitoreo corporal.
            exported="false": solo esta app puede iniciar el service.
        -->
        <service
            android:name=".service.SeizureMonitorService"
            android:exported="false"
            android:foregroundServiceType="health" />

        <!--
            BootReceiver (DEC-069): reanuda el monitoreo tras BOOT_COMPLETED o MY_PACKAGE_REPLACED
            si el usuario lo había dejado encendido. Corte de campo 2026-10-08.
            exported="true" es necesario para recibir broadcasts del sistema; el receiver
            ignora cualquier otra acción.
            LOCKED_BOOT_COMPLETED se omite A PROPÓSITO (direct boot fuera de alcance): si el
            reloj tiene bloqueo de pantalla, el monitoreo se reanuda tras el primer desbloqueo.
        -->
        <receiver
            android:name=".boot.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!--
            DEC-072: alarmas de inicio (22:00) y parada (10:00). exported="false": solo los PendingIntent propios
            llegan acá, así otra app no puede parar el monitoreo mandando la acción de parada.
        -->
        <receiver
            android:name=".schedule.ScheduleAlarmReceiver"
            android:exported="false" />

        <!--
            DEC-072: re-arma las alarmas tras un cambio de hora, de zona horaria o del permiso de alarmas
            exactas. Son broadcasts del sistema; solo re-arma, así que un emisor externo no logra nada.
        -->
        <receiver
            android:name=".schedule.ScheduleRearmReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>

        <!--
            Fase 2.1: Wear Data Layer — recepción de mensajes del teléfono.

            Los listeners de alarm_state y send_settings viven dentro de WearDataLayerManager via
            MessageClient.addListener(): funcionan solo mientras el Service de monitoreo está activo.

            DEC-070: el teléfono puede pedir "/osd/resume_monitoring" cuando lleva horas sin recibir datos.
            Con la app muerta eso solo lo puede recibir un WearableListenerService declarado acá, que
            Play services enlaza por el intent-filter MESSAGE_RECEIVED con un pathPrefix específico (el
            resto del tráfico /osd/* NO lo despierta). exported="true" lo exige la documentación de
            Play services (lo enlaza GMS, un proceso de otro paquete); sin datos sensibles que exponer:
            solo reanuda si el usuario había dejado el monitoreo encendido (was_monitoring).
            Arrancar un foreground service desde acá NO es una excepción documentada de Android:
            mejor esfuerzo, a verificar en hardware (DV-11).
        -->
        <service
            android:name=".data.ResumeRequestListenerService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data
                    android:scheme="wear"
                    android:host="*"
                    android:pathPrefix="/osd/resume_monitoring" />
            </intent-filter>
        </service>

    </application>

</manifest>
